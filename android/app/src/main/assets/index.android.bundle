e74\uc624\ud1a1 parkingpark \uc73c\ub85c \uc5f0\ub77d\uc8fc\uc138\uc694.',notification:'\uc774\ud55c \ub0b4 g',first_notification:'\uc8fc\ucc28\ubb38\uc758,\uae34\uae09\ucd9c\ucc28, \uae30\ud0c0\uc0ac\ud56d\uc740 \uc8fc\ucc28\ubb38\uc758 \uac8c\uc2dc\ud310 \ud639\uc740 \uace0\uac1d\uc13c\ud130 \uc804\ud654, \uce74\uce74\uc624\ud1a1 \ud30c\ud0b9\ubc15\uc73c\ub85c \uc5f0\ub77d\uc8fc\uc138\uc694.',second_notification:'\ucde8\uc18c\uc758 \uacbd\uc6b0 \uae00\uc758 \uc791\uc131 \uc2dc\uac04\uacfc \uc608\uc57d\uc2dc\uac04\uc744 \ube44\uad50\ud574 \ucc98\ub9ac\ud569\ub2c8\ub2e4. \ud604\uc7a5\uacb0\uc81c\ucde8\uc18c\uc758 \uacbd\uc6b0 \ud655\uc778 \ud6c4 \ucd94\uac00\uc801\uc778 \ubb38\uc790 \uc548\ub0b4\uac00 \uc9c4\ud589\ub429\ub2c8\ub2e4.',third_notification:'\ucc28\ub7c9\ubc88\ud638 \ubcc0\uacbd\uc758 \uacbd\uc6b0 \uc544\ub798\uc5d0 \ubcc0\uacbd\ub41c \ucc28\ub7c9\ubc88\ud638\ub97c \uc785\ub825\ud574\uc8fc\uc2dc\uae30 \ubc14\ub77c\uaca0\uc2b5\ub2c8\ub2e4.',requirement:'\uc694\uad6c\uc0ac\ud56d',register:'\ub4f1\ub85d\ud558\uae30',text_input_placeholder:'\uc694\uad6c\uc0ac\ud56d\uc744 \uc785\ub825\ud574\uc8fc\uc138\uc694. \n\ucc28\ub7c9\ubc88\ud638\ubcc0\uacbd \uc120\ud0dd \uc2dc \ubc18\ub4dc\uc2dc \ubcc0\uacbd\ud560 \ucc28\ub7c9\ubc88\ud638\ub97c \n\uc785\ub825\ud574\uc8fc\uc138\uc694.',back_list:'\ubaa9\ub85d',submit:'\uc800\uc7a5',cancel:'\ucde8\uc18c',please_select_request_type:'\uc694\uccad \ubd84\ub958\ub97c \uc120\ud0dd\ud574\uc8fc\uc138\uc694.',please_select_request_type_again:'\uc694\uccad \ubd84\ub958\ub97c \ub2e4\uc2dc \uc120\ud0dd\ud574\uc8fc\uc138\uc694.'},parking_request_notice_board_detail:{list_question:'\ubb38\uc758\uac8c\uc2dc\ud310',write_comment:'\ub313\uae00\uc4f0\uae30',delete:'\uc0ad\uc81c',submit_comment:'\uc804\uc1a1',list:'\ubaa9\ub85d'},coupon_box:{title:'\ucfe0\ud3f0\ud568',search_placeholder:'\ucfe0\ud3f0\ucf54\ub4dc\ub97c \uc785\ub825\ud574\uc8fc\uc138\uc694.',coupon_registration:'\ucfe0\ud3f0\ub4f1\ub85d',coupon_name:'\ucfe0\ud3f0\uba85',coupon_number:'\ucfe0\ud3f0\ubc88\ud638',coupon_sub_name:'\ucfe0\ud3f0\uba85',coupon_status:'\ucfe0\ud3f0\uc0c1\ud0dc'},usage_history:{used_history:'\uc774\uc6a9\ub0b4\uc5ed',all:'\uc804\uccb4',month:'\uac1c\uc6d4',detail:'\uc790\uc138\ud788'},reservation_detail:{title:'\uc608\uc57d\ub0b4\uc6a9',date_of_use:'\uc774\uc6a9\uc77c\uc790',product_option:'\uc0c1\ud488\uc635\uc158',amount_of_payment:'\uce74\ub4dc\uacb0\uc81c\uae08\uc561',reservation_for_use:'\uc0ac\uc6a9\uc801\ub9bd\uae08',charge_for_use:'\uc0ac\uc6a9\ucda9\uc804\uae08',coupon_to_use:'\uc0ac\uc6a9\ucfe0\ud3f0',receipt_application:'\uc601\uc218\uc99d\uc2e0\uccad',email_registration:'\uc774\uba54\uc77c\ub4f1\ub85d',policy:'\uc608\uc57d \ucde8\uc18c\uc2dc \ud658\ubd88 \uaddc\uc815',back_all_money:'\u2022 \uc785\ucc28\uc77c\uc790 \ubc0f \uc785\ucc28(\uc785\ub825\ub41c) \uc2dc\uac04\uc804 : \uc804\uc561\ud658\ubd88',back_half_of_money:'\u2022 \uc6d4\uc8fc\ucc28 \ub4f1\ub85d\ud6c4 \ub610\ub294 \uc774\uc6a9\uc911 \ud574\uc9c0 \uc694\uccad\uc2dc \ud574\uc9c0\uc218\uc218\ub8cc 2\ub9cc\uc6d0 \ubd80\uacfc',back_half_of_money2:'\u2022 \uc6d4\uc8fc\ucc28 \uc911\uac04\ud574\uc9c0\uc2dc \uc694\uae08\ubd80\uacfc \uc548\ub0b4\n   \ud574\uc9c0\uc218\uc218\ub8cc 2\ub9cc\uc6d0 +(\uc77c\ucd5c\ub300\uc694\uae08 x \uc774\uc6a9\uc77c\uc218)',back_half_of_money3:'\u2022 \uc6d4\uc8fc\ucc28 \ubbf8\ub4f1\ub85d \uc0c1\ud0dc\uc5d0\uc11c \uc2dc\uc791\uc77c \uc804 \ud574\uc9c0\uc2dc \uc804\uc561 \ud658\ubd88',can_not_back_money:'\u2022 \uc785\ucc28\uc77c\uc790 \ubc0f \uc785\ucc28\uc2dc\uac04 \uc774\ud6c4 : \ud658\ubd88 \ubd88\uac00',note_first:'\u2022 \uc8fc\ucc28\uc7a5 \uc774\uc6a9\uc57d\uad00\uc744 \uc9c0\ucf1c\uc8fc\uc2dc\uace0, \uc8fc\ucc28\uc7a5 \ub0b4\uc5d0\uc11c \ubc1c\uc0dd\ud558\ub294 \ubaa8\ub4e0 \uc0ac\uace0\uc5d0 \ub300\ud574\uc11c\ub294 \ud30c\ud0b9\ubc15\uc774 \ucc45\uc784\uc9c0\uc9c0\uc54a\uc2b5\ub2c8\ub2e4.',note_second:'\u2022 \uc608\uc57d\ud55c \uc774\uc6a9\uc2dc\uac04 \uc774\uc678\uc5d0 \ucd9c\ucc28\ud560 \uacbd\uc6b0\uc5d0\ub294 \ucd94\uac00 \uc8fc\ucc28\uc694\uae08\uc774 \uacfc\uae08\ub418\uac70\ub098 \ucd9c\ucc28\uac00 \uc81c\ud55c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.',info_user:'\uc774\uc6a9\uc790\uc815\ubcf4',car_number:'\ucc28\ub7c9\ubc88\ud638',vehicle_type:'\ucc28\ub7c9\uae30\uc885',vehicle_color:'\ucc28\ub7c9\uc0c9\uc0c1',contact:'\uc5f0\ub77d\ucc98',email:'\uc774\uba54\uc77c'},simple_reservation:{title:'\uac04\ud3b8\uc608\uc57d',note:'\ub0b4\uac00 \uc774\uc6a9\ud55c \uc8fc\ucc28\uc7a5\uc744 \ud074\ub9ad \ud55c\ubc88\uc73c\ub85c \uac04\ud3b8\ud558\uac8c \uc608\uc57d\ud560\uc218 \uc788\uc5b4\uc694!',booking:'\uc608\uc57d'},point_management:{title:'\uc801\ub9bd\uae08',available:'\uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc801\ub9bd\uae08'},reservation:{text_title:'\ud558\uc774\ud30c\ud0b9 \uad11\ud654\ubb38 D\ud0c0\uc6cc (\uc6d4\uc8fc\ucc28)',text_top_1:'\uc81c\ud734 \uc8fc\ucc28\uba74\uc218 :',text_top_2:'\uc5f0\ubc15\ubd88\uac00\ub2a5',text_top_3:'\uc790\uc8fc\uc2dd',text_policy_1:'\uc785\ucc28 \uc804 \uacb0\uc81c \ud544\uc218',text_policy_2:'(\uc785\ucc28\uc804 \uacb0\uc81c\ud544\uc218/\uc785\ucc28 \ud6c4 \uacb0\uc81c\ub85c \uc778\ud55c \ud604\uc7a5\uacb0\uc81c \uc2dc \ucde8\uc18c\ubd88\uac00)',text_policy_3:'\ub9cc\ucc28 \ud639\uc740 \ud604\uc7a5 \uc0ac\uc815\uc5d0 \ub530\ub77c\uc11c \uc8fc\ucc28\uac00 \uc5b4\ub824\uc6b8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.',text_policy_4:"\uc6d4 \uc815\uae30\uad8c \uc911\uac04 \ud574\uc9c0 \ubc0f \ud658\ubd88 \ud76c\ub9dd \uc2dc,\n(\uc790\uc8fc\ubb3b\ub294 \uac8c\uc2dc\ud310) FAQ\ub97c \ud655\uc778\ud574\uc8fc\uc2dc\uba74 \uac10\uc0ac\ud558\uaca0\uc2b5\ub2c8\ub2e4.",text_policy_5:"\uc6d4\uc8fc\ucc28 \ub4f1\ub85d \ud6c4 \uc774\uc6a9\uc804\uc774\ub77c\ub3c4 \uae30\ubcf8\ud574\uc9c0 \uc218\uc218\ub8cc 2\ub9cc\uc6d0 \ubd80\uacfc\n\uc774\uc6a9\uc911 \ud574\uc9c0 \uc694\uccad\uc2dc \uc218\uc218\ub8cc2\ub9cc\uc6d0+(\ud604\uc7a5 \uc77c\ucd5c\ub300\uc694\uae08 x \uc774\uc6a9\uc77c\uc218)",description_voucher:'\uc801\ub9bd\uae08\uc740 \uae30\ubcf8 \ud68c\ub2f9 1,000\uc6d0\uae4c\uc9c0 \uc0ac\uc6a9\uac00\ub2a5\n(\ub2e8, \uc8fc\ucc28\uad8c\uc694\uae08 6,000\uc6d0\uc774\uc0c1 \uad6c\ub9e4\uc2dc \uc0ac\uc6a9\uac00\ub2a5) \uc6d4\uc8fc\ucc28\uad8c \uad6c\ub9e4\uc2dc\uc5d0\ub294 10\ub9cc\uc6d0\uc774\uc0c1 3\ucc9c\uc6d0,\n15\ub9cc\uc6d0\uc774\uc0c1 5\ucc9c\uc6d0\uae4c\uc9c0 \uc0ac\uc6a9\uac00\ub2a5',description_voucher_1:'* \uc801\ub9bd\uae08 \uc0ac\uc6a9\uc548\ub0b4',description_voucher_2:'\uc801\ub9bd\uae08\uc740 \uae30\ubcf8 \ud68c\ub2f9 1,000\uc6d0\uae4c\uc9c0 \uc0ac\uc6a9\uac00\ub2a5\n(\ub2e8, \uc8fc\ucc28\uad8c\uc694\uae08 6,000\uc6d0\uc774\uc0c1 \uad6c\ub9e4\uc2dc \uc0ac\uc6a9\uac00\ub2a5)\n\uc6d4\uc8fc\ucc28\uad8c \uad6c\ub9e4\uc2dc\uc5d0\ub294 10\ub9cc\uc6d0\uc774\uc0c1 3\ucc9c\uc6d0,\n15\ub9cc\uc6d0\uc774\uc0c1 5\ucc9c\uc6d0 \uae4c\uc9c0 \uc0ac\uc6a9\uac00\ub2a5',description_charge_comment:'\ucda9\uc804\uae08\uc73c\ub85c \uacb0\uc81c\uc2dc \ucda9\uc804\uae08 \ucda9\uc804\ud6c4 \uc774\uc6a9\uac00\ub2a5',content:{text1:"1.'\ud30c\ud0b9\ubc15' : \"\ud68c\uc0ac\"\uac00 \ucef4\ud4e8\ud130,\ud14c\ube14\ub9bf,\uc2a4\ub9c8\ud2b8\ud3f0 \ub4f1 \uc815\ubcf4\ud1b5\uc2e0\uae30\uae30\ub97c \uc774\uc6a9\ud558\uc5ec '\uc11c\ube44\uc2a4'\ub97c \uc81c\uacf5\ud560 \uc218 \uc788\ub3c4\ub85d \uc124\uc815\ud55c \uc628\ub77c\uc778 \uc601\uc5c5\uc7a5\uc744 \uc758 \ubbf8\ud569\ub2c8\ub2e4.\n",text2:"2'\ud68c\uc6d0': '\ud68c\uc6d0'\uc774\ub77c \ud568\uc740 \ud68c\uc0ac\uc5d0 \uac1c\uc778\uc815\ubcf4\ub97c \uc81c\uacf5\ud558\uc5ec \ud68c\uc6d0\ub4f1\ub85d\uc744 \ud55c \uc790\ub85c\uc11c, '\ud30c\ud0b9\ubc15'\uc5d0\uc11c \uc81c\uacf5\ud558\ub294 \uc815\ubcf4\ub97c \uc9c0\uc18d\uc801\uc73c\ub85c \uc81c\uacf5\ubc1b\uc73c\uba70, \uc774\uc6a9\ud560\uc218 \uc788\ub294 \uc790\ub97c \ub9d0\ud569\ub2c8\ub2e4. '\ud68c\uc0ac'\ub294 \uc11c\ube44\uc2a4\uc758 \uc6d0\ud65c\ud55c \uc81c\uacf5\uc744 \uc704 \ud574 \ud68c\uc6d0\uc758 \ub4f1\uae09\uc744 \ud68c\uc0ac \ub0b4\ubd80\uc758 \uaddc\uc815\uc5d0 \ub530\ub77c \ub098\ub20c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n",text3:"1.'\ud30c\ud0b9\ubc15' : \"\ud68c\uc0ac\"\uac00 \ucef4\ud4e8\ud130,\ud14c\ube14\ub9bf,\uc2a4\ub9c8\ud2b8\ud3f0 \ub4f1 \uc815\ubcf4\ud1b5\uc2e0\uae30\uae30\ub97c \uc774\uc6a9\ud558\uc5ec '\uc11c\ube44\uc2a4'\ub97c \uc81c\uacf5\ud560 \uc218 \uc788\ub3c4\ub85d \uc124\uc815\ud55c \uc628\ub77c\uc778 \uc601\uc5c5\uc7a5\uc744 \uc758\n"},parking_rules:{title:'\uc8fc\ucc28\uc7a5 \uc774\uc6a9\uaddc\uce59',content:'\uaf2d \ud655\uc778\ud558\uc138\uc694!',text:'[\uc6d4\uc8fc\ucc28\ub294 \uc785\ucc28\uc77c\ub85c\ubd80\ud130 \ud55c\ub2ec \uc774\uc6a9] \ucd9c\ucc28\uc2dc \ucc28\ub2e8\uae30\uac00 \uc5f4\ub9ac\uc9c0\uc54a\uc744\uc2dc\ucc28\ub2e8\uae30 \uc606\uc5d0\uc788\ub294 \uad00\ub9ac\uc790\uc5d0\uac8c \ud30c\ud0b9\ubc15\uc571\uc5d0\uc11c \uacb0\uc81c\ud558\uc2e0 \ub0b4\uc5ed(\ucc28\ub7c9\ubc88\ud638,\uc77c\uc790)\uc744 \ub9d0\uc500\ud558\uc2e0 \ud6c4 \ucd9c\ucc28\ud558\uc2dc\uba74 \ub429\ub2c8\ub2e4.'},parking_content:{text1:'\uc120\ubd88\uc8fc\ucc28\uad8c \uad6c\ub9e4 \ubc0f \uc785\ucc28 \ud6c4,',text2:'\uc8fc\ucc28\uad8c \ucd94\uac00\uad6c\ub9e4 \uc0ac\uc6a9 \uc808\ub300\ubd88\uac00',text3:'\ud569\ub2c8\ub2e4.',text4:'\uc73c\ub85c \ubd80\uacfc\ub429\ub2c8\ub2e4.',text5:'\ucd08\uacfc\uc0ac\uc6a9\uc2dc, \ud604\uc7a5\uc694\uae08'},explore_parking:'\ub2e4\ub978 \uc870\uac74\uc744 \uac00\uc9c4 \uc8fc\ucc28\uc7a5 \ub458\ub7ec\ubcf4\uae30!',info_user:{title:'\uad6c\ub9e4\uc790 \uc815\ubcf4',content:'\uce74\ub4dc\uc815\ubcf4\ub97c \ud655\uc778\ud558\uc138\uc694!'},info_month_pay:{title:'\ub9e4\ub2ec \uc6d4\uc8fc\ucc28\uad8c \uacb0\uc81c\uac00 \ubc88\uac70\ub85c\uc6b0\uc2e0\uac00\uc694?',content:'\uc790\ub3d9\uacb0\uc81c \uc2e0\uccad\uc804 \uaf2d \ud655\uc778\ud574 \uc8fc\uc138\uc694!',c_request:'\uc6d4\uc8fc\ucc28\uad8c \uc790\ub3d9\uacb0\uc81c \uc2e0\uccad\ud558\uae30'},info_voucher:'\ud560\uc778\uc815\ubcf4',help:{title:'\uc8fc\ucc28\uad8c \uc548\ub0b4',content:'\ubaa8\ub4e0 \uc8fc\ucc28\uad8c\uc740 \uc8fc\ucc28\uad8c\uc5d0 \uc548\ub0b4\ub41c \uc2dc\uac04\uc73c\ub85c\ub9cc\n\uc774\uc6a9\uac00\ub2a5 \ud569\ub2c8\ub2e4.',text1:'1\uc77c\uad8c : \uc8fc\ucc28\uc7a5\uc774 \uc815\ud55c \uc2dc\uac04 \uc548\uc5d0\uc11c \uc608\uc57d\uc77c\n(\ub2f9\uc77c) \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc8fc\ucc28\uad8c\n(\uc785\ucc28\ud55c \uc2dc\uac04\uacfc\ub294 \uc0c1\uad00\uc5c6\uc774 \uc8fc\ucc28\uad8c \uc885\ub8cc \uc2dc\n\uac04\uae4c\uc9c0 \uc774\uc6a9 \uac00\ub2a5)',text2:'\uc608) 1\uc77c\uad8c(00:00-23:59) \uad6c\ub9e4 \ud6c4 \ubc24 11\uc2dc\n\uc785\ucc28\ud574\ub3c4, \uc785\ucc28\uc77c 23:59\ubd84\uae4c\uc9c0\ub9cc \uc774\uc6a9 \uc544\uac00\ub2a5',text3:'\uc2ec\uc57c\uad8c : \ub2f9\uc77c \uc624\ud6c4 6\uc2dc \uc774\ud6c4\ubd80\ud130 \ub2e4\uc74c\ub0a0(\uc775\n\uc77c) \uc624\uc804 6\uc2dc\uae4c\uc9c0 \uc774\uc6a9 \uac00\ub2a5\ud55c \uc8fc\ucc28\uad8c',text4:'\uc5f0\ubc15 : 1\uc77c\uad8c \uacb0\uc81c \ud6c4 \uc5f0\uc18d\uc73c\ub85c \uc774\uc5b4\uc11c \uc8fc\ucc28\n\ud558\ub294 \ubc29\uc2dd(\ub0a0\uc774 \ubc14\ub00c\uba74 \uc5f0\ubc15)'}},tutorial_button:'\uc2dc\uc791\ud558\uae30',usage_history_detail:{header:'\uc608\uc57d\ub0b4\uc6a9',year:'\ub144',month:'\uc6d4',day:'\uc77c'},vehicle_number:{title:'\ucc28\ub7c9\uc815\ubcf4',title1:'\ucc28\ub7c9\ubc88\ud638',title2:'\ucc28\ub7c9\ubaa8\ub378',title3:'\ucc28\ub7c9\uc0c9\uc0c1',title4:'\ucc28\ub7c9\uc5f0\uc2dd',title5:'\uc81c\uc870\uc0ac',title6:'\ucc28\ub7c9\uc815\ubcf4 \ub4f1\ub85d',title7:'\ucee4\ub125\ud2f0\ub4dc\uce74 \uc5f0\ub3d9',hyundai:'\ud604\ub300',kia:'\uae30\uc544',genesis:'\uc81c\ub124\uc2dc\uc2a4',linking:'\uc5f0\ub3d9\uc911'},vehicle_number_manage:{title:'\ucc28\ub7c9\ubc88\ud638 \uad00\ub9ac'},valet_parking_reservation_popup:{cancel:'\ucde8\uc18c\ud558\uae30'},valet_qna_bbs_list:{header:'\ubb38\uc758\uac8c\uc2dc\ud310',permission:'\uc791\uc131\uc790\uc640 \uad00\ub9ac\uc790\ub9cc \uc870\ud68c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.'},valet_qna_bbs_detail:{empty_reply_list:'\ub4f1\ub85d\ub41c \uae00\uc774 \uc5c6\uc2b5\ub2c8\ub2e4.'},valet_qna_bbs_create:{header:'\uae00\uc4f0\uae30',place_holder_title:'\uc81c\ubaa9\uc744 \uc785\ub825\ud574 \uc8fc\uc138\uc694.',place_holder_info_detail:'\ub0b4\uc6a9\uc744 \uc785\ub825\ud574 \uc8fc\uc138\uc694.'},valet_payment_history_admin:{header:'\ubc1c\ub81b\ud30c\ud0b9 \uc608\uc57d\ub0b4\uc5ed'},valet_parking_admin_reservation_1:{header:'1\ub2e8\uacc4. \uace0\uac1d\uc815\ubcf4',parking_lot_name:'\uc8fc\ucc28\uc7a5\uba85',car_number:'\ucc28\ub7c9\ubc88\ud638',car_model:'\ucc28\ub7c9\uae30\uc885',car_color:'\ucc28\ub7c9\uc0c9\uc0c1',contact:'\uc5f0\ub77d\ucc98',car_together:'\ub3d9\ud589\ucc28\ub7c9',other_request:'\uae30\ud0c0\uc694\uccad\uc0ac\ud56d',main_board_image:'\uacc4\uae30\ud310',front_image:'\uc804\uba74',left_image:'\uce21\uba741',right_image:'\uce21\uba742',end_image:'\ud6c4\uba74',parking_not_not_existed:'\uc6b4\uc601\uc774 \uc911\uc9c0\ub41c \uc8fc\ucc28\uc7a5\uc785\ub2c8\ub2e4. \uc2e4\uc81c\uc640 \uc815\ubcf4\uac00 \ub2e4\ub97c \uacbd\uc6b0 \uad00\ub9ac\uc790\uc5d0\uac8c \ubb38\uc758 \ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4.'},valet_parking_admin_reservation_2:{header:'2\ub2e8\uacc4. \uc785/\ucd9c\uad6d \uc815\ubcf4',departure_information:'\ucd9c\uad6d\uc815\ubcf4',departure_date:'\ucd9c\uad6d\uc77c\uc2dc',outbound_flight:'\ucd9c\uad6d\ud56d\uacf5\ud3b8',immigration:'\uc785\uad6d\uc815\ubcf4',date_of_entry:'\uc785\uad6d\uc77c\uc2dc',night_departure:'\uc57c\uac04\ucd9c\ucc28',inbound_flight:'\uc785\uad6d\ud56d\uacf5\ud3b8'},valet_parking_admin_reservation_3:{header:'3\ub2e8\uacc4. \ubc1c\ub81b\uc8fc\ucc28 \uc608\uc57d',parking_lot_name:'\uc8fc\ucc28\uc7a5\uba85',entry_date_and_time:'\uc785\ucc28\uc77c\uc2dc',departure_date_and_time:'\ucd9c\ucc28\uc77c\uc2dc',reverse:'\uc801\ub9bd\uae08',coupon:'\ucfe0\ud3f0',actual_payment_amount:'\uc2e4 \uacb0\uc81c\uae08\uc561'},valet_parking_image_detail:{back:'\ub098\uac00\uae30',delete:'\uc0ad \uc81c'},consent_popup:{header:'\ud30c\ud0b9\ubc15 \uc11c\ube44\uc2a4 \uc774\uc6a9\ub3d9\uc758',term_of_use:'\uc774\uc6a9\uc57d\uad00',view_content:'\ub0b4\uc6a9\ubcf4\uae30',pr