bd\uae08 \uc9c0\uae09\ud61c\ud0dd',hot_place:'\ud56b\ud50c\ub808\uc774\uc2a4 \uc8fc\ucc28'},service_terms_and_conditions:{title:'\uc57d\uad00\ub3d9\uc758',content:'\uce74\ud480 \uc11c\ube44\uc2a4 \uc774\uc6a9\uc744 \uc704\ud55c \ud544\uc218 \uc57d\uad00\n\ubc0f \ubcf4\ud5d8 \uac00\uc785\uc5d0 \ub3d9\uc758\ud574\uc8fc\uc138\uc694.',check1:'\uc57d\uad00 \uc804\uccb4\ub3d9\uc758',check2:'(\ubb34\ub8cc)\ud0dc\uc6cc\uc918-\uce74\ud480 \uc548\uc2ec\ubcf4\ud5d8 \uac00\uc785\ub3d9\uc758',item1:'[\ud544\uc218] \ud0dc\uc6cc\uc918 \uc11c\ube44\uc2a4 \uc774\uc6a9\uc57d\uad00',item2:'[\ud544\uc218] \uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68',item3:'[\ud544\uc218] \uc704\uce58\uae30\ubc18 \uc774\uc6a9\uc57d\uad00',item4:'[\ud544\uc218] \ud0dc\uc6cc\uc918 \uc11c\ube44\uc2a4 \uc774\uc6a9\uc57d\uad00',policy:{title:'KB\uc190\ud574\ubcf4\ud5d8\u201d\ud0dc\uc6cc\uc918\u201d\uce74\ud480 \uc548\uc2ec\ubcf4\ud5d8 \uc548\ub0b4',content:[{title:'\ubcf4\ud5d8\uc0c1\ud488',content:'(\ubb34\ub8cc)\ud0dc\uc6cc\uc918-\uce74\ud480 \uc548\uc2ec \ubcf4\ud5d8'},{title:'\uac00\uc785\uae30\uac04',content:'\uac00\uc785\uc2dc~1\uac1c\uc6d4(\ud68c\uc6d0\ud0c8\ud1f4\uc2dc\uae4c\uc9c0 1\uac1c\uc6d4\uc529 \uc790\ub3d9\uc5f0\uc7a5'},{title:'\ucc38\uc5ec\ub300\uc0c1',content:'\u201c\ud0dc\uc6cc\uc918\u201d\uc774\uc6a9\uace0\uac1d \ubaa8\ub450'},{title:'\ubcf4\uc7a5\uae08\uc561',content:'\uc0c1\ud574\uc0ac\uc7a5,\uc0c1\ud574 \ud6c4\uc720\uc7a5\uc560 3,000\ub9cc\uc6d0,\ud3ed\ub825\ud53c\ud574\uc704\ub85c\uae08 500\ub9cc\uc6d0'}]},button:'\ud655\uc778'},terms_and_conditions:{title:'\ud0dc\uc6cc\uc918 \uc11c\ube44\uc2a4 \uc774\uc6a9\uc57d\uad00',content:r(d[0]).string_terms_and_conditions,checkbox:'\uc704 \ub0b4\uc6a9\uc5d0 \ub3d9\uc758\ud569\ub2c8\ub2e4.',button:'\ud655\uc778'},private_policy:{title:'\uac1c\uc778\uc815\ubcf4 \ucc98\ub9ac\ubc29\uce68',content:r(d[1]).string_private_policy,checkbox:'\uc704 \ub0b4\uc6a9\uc5d0 \ub3d9\uc758\ud569\ub2c8\ub2e4.',button:'\ud655\uc778'},location_based_terms_of_use:{title:'\uc704\uce58\uae30\ubc18 \uc774\uc6a9\uc57d\uad00',content:r(d[2]).string_location_based_terms_of_use,checkbox:'\uc704 \ub0b4\uc6a9\uc5d0 \ub3d9\uc758\ud569\ub2c8\ub2e4.',button:'\ud655\uc778'},agree_to_subscribe_to_carpool:{title:'\ud0dc\uc6cc\uc918-\uce74\ud480 \uc548\uc2ec\ubcf4\ud5d8 \uac00\uc785\ub3d9\uc758',text1:'\u25c6 \uac1c\uc778 \uc2e0\uc6a9\uc815\ubcf4\uc758 \uc81c\uacf5 \ud65c\uc6a9 \ub3d9\uc758\n \uc774 \uacc4\uc57d\uacfc \uad00\ub828\ud558\uc5ec \uadc0\uc0ac\uac00 \ubcf8\uc778\uc73c\ub85c\ubd80\ud130 \ucde8\ub4dd\ud55c \uac1c\uc778\uc2e0\uc6a9\uc815\ubcf4\ub97c \ud0c0\uc778\uc5d0\uac8c \uc81c\uacf5\ud558\uac70\ub098 \uc2e0\uc6a9\uc815\ubcf4\uc9d1\uc911\uae30\uad00\uc73c\ub85c\ubd80\ud130 \ubcf8\uc778\uc758 \uac1c\uc778\uc2e0\uc6a9\uc815\ubcf4\ub97c \uc870\ud68c\ud558\uace0\uc790 \ud558\ub294 \uacbd\uc6b0\uc5d0\ub294  "\uc2e0\uc6a9\uc815\ubcf4\uc758 \uc774\uc6a9 \ubc0f \ubcf4\ud638\uc5d0 \uad00\ud55c \ubc95\ub960" \uc81c32\uc870\uc5d0 \ub530\ub77c \ub3d9\uc758\ub97c \uc5bb\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc774\uc5d0 \ud53c\ubcf4\ud5d8\uc790 \ubcf8\uc778\uc740 \uc640\uc774\uc988\ubaa8\ubc14\uc77c(\uc8fc)\uac00 \uc81c\uacf5\ud558\ub294 KB\uc190\ud574\ubcf4\ud5d8\u321c\uc758 \ud50c\ub7ec\uc2a4\uc0ac\ub791\ub2e8\uccb4\uc0c1\ud574\ubcf4\ud5d8\uc5d0 \uac00\uc785\ud558\ub294 \uac83\uc744 \ub3d9\uc758\ud558\uba70, \ub610\ud55c "\uc2e0\uc6a9\uc815\ubcf4\uc758 \uc774\uc6a9 \ubc0f \ubcf4\ud638\uc5d0 \uad00\ud55c \ubc95\ub960" \uc81c32\uc870\uc5d0\uc11c \uc815\ud558\ub294 \uc808\ucc28\uc5d0 \ub530\ub77c \uac1c\uc778\uc2e0\uc6a9\uc815\ubcf4\uc758 \uc81c\uacf5\xb7\ud65c\uc6a9\uc5d0 \ub3d9\uc758\ud558\uace0, \ub3d9\uc758\uc11c\uc5d0 \uae30\uc7ac\ud558\uc5ec \uc81c\uacf5\ud558\ub294  \uc2e0\uc6a9\uc815\ubcf4\uc758 \ub0b4\uc6a9\uc5d0 \uc544\ub798\uc758 \uc0ac\ud56d\uc774 \ud3ec\ud568\ub428\uc744 \ud655\uc778\ud569\ub2c8\ub2e4.',text2:"[\uac1c\uc778\uc2e0\uc6a9\uc815\ubcf4\uc758 \uc81c\uacf5\uc5d0 \uad00\ud55c \ub0b4\uc6a9]\n- \uc81c\uacf5\ub300\uc0c1\uae30\uad00: \uc8fc\uc2dd\ud68c\uc0acKB\uc190\ud574\ubcf4\ud5d8\n'- \uc81c\uacf5\ubaa9\uc801: (\uc8fc)KB\uc190\ud574\ubcf4\ud5d8\uc758 \ud50c\ub7ec\uc2a4\uc0ac\ub791\ub2e8\uccb4\uc0c1\ud574\ubcf4\ud5d8 \uac00\uc785\n'- \uc81c\uacf5\ubc1b\ub294\uc790\uc758 \uc815\ubcf4 \ubcf4\uc720, \uc774\uc6a9\uae30\uac04:  \ubcf8 \uacc4\uc57d\uc758 \uccb4\uacb0\uc2dc\ubd80\ud130 \uc704 \ubc95 \uc81c37\uc870\uc5d0 \ub530\ub77c \uac1c\uc778\uc2e0\uc6a9\uc815\ubcf4 \uc81c\uacf5, \uc774\uc6a9\ub3d9\uc758\ub97c \ucca0\ud68c\ud55c \ub54c\uae4c\uc9c0\n'- \uc81c\uacf5\ud560 \uac1c\uc778\uc2e0\uc6a9\uc815\ubcf4\uc758 \ub0b4\uc6a9\n(1) \ud53c\ubcf4\ud5d8\uc790\uc758 \uc131\uba85, \uc5f0\ub77d\ucc98 \ub4f1 \uac1c\uc778\uc2dd\ubcc4\uc815\ubcf4\n(2) \ud53c\ubcf4\ud5d8\uc790\uc758 \"\ud0dc\uc6cc\uc918\" \uc11c\ube44\uc2a4 \uc774\uc6a9\uc77c/\uc774\uc6a9\uad6c\uac04/\ud574\uc9c0\uc77c  \ub4f1 \ubcf4\ud5d8\uad00\ub828 \uacc4\uc57d\ub0b4\uc6a9\n\n\u203b \ubb34\ub8cc \ubcf4\ud5d8 \uac00\uc785\uc5d0 \ub3d9\uc758\ud569\ub2c8\ub2e4.",agree:'\ub3d9\uc758\ud569\ub2c8\ub2e4.',text3:'\uc774\uc5d0 \ub300\ud55c \ub0b4\uc6a9\uc744 \uc124\uba85\ub4e4\uc5c8\uc73c\uba70 \uc774\ub97c \ud655\uc778\ud558\uc600\uace0, \uc640\uc774\uc988\ubaa8\ubc14\uc77c(\uc8fc)\uc5d0\uc11c \uace0\uac1d\ub2d8\uc744 \ud53c\ubcf4\ud5d8\uc790\ub85c \uacc4\uc57d\ud558\ub294 \uac83\uc5d0 \ub3d9\uc758\ud569\ub2c8\ub2e4.',text4:'\uc0c1\ubc95 \uc81c731\uc870\uc5d0 \uc758\uac70\ud558\uc5ec \ubb34\ub8cc\ubcf4\ud5d8 \ubcf4\uc7a5\ub0b4\uc6a9 \uc911 \uc0ac\ub9dd\ub2f4\ubcf4\uac00 \ud3ec\ud568\ub418\uc5b4 \uc788\ub294 \uacbd\uc6b0 \ub3d9\uc758\ub97c \ud574 \uc8fc\uc154\uc57c\ub9cc \uacc4\uc57d\uc774 \uc720\ud6a8\ud558\uac8c \uc131\ub9bd\ub418\uba70, \ubcf4\uc7a5\uc744 \ubc1b\uc73c\uc2e4 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\u261e \uc0c1\ubc95\uc81c731\uc870 (\ud0c0\uc778\uc758 \uc0dd\uba85\uc758 \ubcf4\ud5d8)\n\u2460\ud0c0\uc778\uc758 \uc0ac\ub9dd\uc744 \ubcf4\ud5d8\uc0ac\uace0\ub85c \ud558\ub294 \ubcf4\ud5d8\uacc4\uc57d\uc5d0\ub294 \ubcf4\ud5d8\uacc4\uc57d \uccb4\uacb0\uc2dc\uc5d0 \uadf8 \ud0c0\uc778\uc758 \uc11c\uba74\uc5d0 \uc758\ud55c \ub3d9\uc758\ub97c \uc5bb\uc5b4\uc57c \ud55c\ub2e4. \n\u2461\ubcf4\ud5d8\uacc4\uc57d\uc73c\ub85c \uc778\ud558\uc5ec \uc0dd\uae34 \uad8c\ub9ac\ub97c \ud53c\ubcf4\ud5d8\uc790\uac00 \uc544\ub2cc \uc790\uc5d0\uac8c \uc591\ub3c4\ud558\ub294 \uacbd\uc6b0\uc5d0\ub3c4 \uc81c1\ud56d\uacfc\uac19\ub2e4.',resident_registration_number:'\uc8fc\ubbfc\ub4f1\ub85d\ubc88\ud638 \uc785\ub825 : ',placeholder:'000000',placeholderName:'\ud64d\uae38\ub3d9',principle:'\ud53c\ubcf4\ud5d8\uc790(\ubcf8\uc778) \uc131\uba85 : ',name:' \uc11c\uba85/\uc778',button:'\ud655\uc778'},quick_action_memu:{give_me_a_drive:'\uce74\ud480 \uc11c\ube44\uc2a4',make_commuting_more_convenient_with_carpooling:'\uce74\ud480\ub85c \ucd9c\ud1f4\uadfc\uc744\n\ub354\uc6b1 \ud3b8\ub9ac\ud558\uac8c',airport_parking:'\uacf5\ud56d\uc8fc\ucc28',parking_when_traveling_easily:'\uc5ec\ud589\uc2dc \uc8fc\ucc28\ub97c\n\uac04\ud3b8\ud558\uac8c',valet_parking:'\ubc1c\ub81b\ud30c\ud0b9',worry_about_parking_when_traveling:'\uc5ec\ud589\uc2dc \uc8fc\ucc28 \uac71\uc815\n\uadf8\ub9cc!',parking_sharing:'\uc8fc\ucc28\uacf5\uc720',share_your_parking_lot_and_make_money:'\uc8fc\ucc28\uc7a5 \uacf5\uc720\ud558\uace0\n\uc218\uc775 \ucc3d\ucd9c',monthly_parking_direct:'\uc6d4\uc8fc\ucc28\uc9c1\uac70\ub798',parking_lot_is_also_sold_directly:'\uc8fc\ucc28\uc7a5\ub3c4 \uc9c1\uac70\ub798\n\ud558\uc790'},business_card_and_vaccine_registration:{title:'\uba85\ud568 \ubc0f \ubc31\uc2e0 \ub4f1\ub85d',cancel:'\uac74\ub108\ub6f0\uae30',occupation:'\uc9c1\uc885',placeholder_occupation:'\uc9c1\uc885\uc744 \uc120\ud0dd\ud574\uc8fc\uc138\uc694.',detail:'\uc0c1\uc138\uc9c1\uc5c5',placeholder_detail:'\uc0c1\uc138\ud55c \uc9c1\uc5c5\uc744 \uc785\ub825\ud574\uc8fc\uc138\uc694.',company_name:'\ud68c\uc0ac\uba85',placeholder_company_name:'\ud68c\uc0ac\uba85\uc744 \uc785\ub825\ud574\uc8fc\uc138\uc694.',company_address:'\ud68c\uc0ac\uc8fc\uc18c',placeholder_company_address:'\ud68c\uc0ac \uc8fc\uc18c\ub97c \uc785\ub825\ud574\uc8fc\uc138\uc694.',bottom_sheet:{title:'\uc9c1\uc885',contents:['\ud68c\uc0ac\uc6d0','\uc0ac\uc5c5\uac00','\uc790\uc601\uc5c5','\uc804\ubb38\uc9c1','\uae30\ud0c0']}},carpool_request_registration_list:{title:'\uce74\ud480 \uc694\uccad \ub4f1\ub85d\ub9ac\uc2a4\ud2b8',bottom_sheet_filter:{title:'\ud544\ud130\ub9c1',route:'\uacbd\ub85c',viewingPeriod:'\uc870\ud68c\uae30\uac04',wayWork:'\ucd9c\uadfc\uae38',wayHome:'\ud1f4\uadfc\uae38',subPeriod:'\ucd5c\ub300 2\uc8fc\uae4c\uc9c0 \uc870\ud68c \uac00\ub2a5\ud569\ub2c8\ub2e4.',placeholderStart:'\uc2dc\uc791',placeholderEnd:'\ub9c8\uc9c0\ub9c9',reload:'\ucd08\uae30\ud654',filter:'\uc644\ub8cc'}},driver_register:{register:'\ub4f1\ub85d\ud558\uae30',quick_link:'\ub4dc\ub77c\uc774\ubc84 QUICK \ub4f1\ub85d \ubc14\ub85c\uac00\uae30',driver_information_register:'\ub4dc\ub77c\uc774\ubc84\uc815\ubcf4\ub4f1\ub85d',car_infor:'\ucc28\ub7c9\uc815\ubcf4',obligate_sign_up_to_allow_pick_up:'\uce74\ud480\ub4dc\ub77c\uc774\ubc84\ub97c \uc2b9\uc778 \ubc1b\uae30 \uc704\ud574\uc11c\ub294 \ucc28\ub7c9\uc815\ubcf4 \ub4f1\ub85d\uc740 \ud544\uc218 \uc785\ub2c8\ub2e4.',car_is_available_or_doesnt_allow_run:'\uc774\uc6a9 \ubc0f \uc2b9\uc778 \ubd88\uac00 \ucc28\ub7c9',rental_car:'\ub80c\ud2b8\ucc28\ub7c9',shared_car:'\uce74\uc170\uc5b4\ub9c1\ucc28\ub7c9',car_over_10_ages:'\uc5f0\uc2dd10\ub144\uc774\uc0c1 \ucc28\ub7c9',light_car:'\uacbd\ucc28',car_image:'\ucc28\ub7c9\uc0ac\uc9c4',quick_title:'\ub4dc\ub77c\uc774\ubc84 \uc11c\ub958 \ub4f1\ub85d\uc774 \ubc88\uac70\ub85c\uc6b0\uc2e0\uac00\uc694?',please_register_photos_of_the_front_back_sides_and_interior_of_the_car:'\ucc28\ub7c9 \uc55e,\ub4a4,\uc606,\ub0b4\ubd80 \uc0ac\uc9c4\uc744 \ud615\uc2dd\uc5d0 \ub9de\ucdb0 \ub4f1\ub85d\ud574\uc8fc\uc138\uc694!',quick_content:'\uce5c\uc808\ud55c \ud30c\ud0b9\ubc15 \uce74\ud480 \ub9e4\ub2c8\uc800\uac00 \ub3c4\uc640\ub4dc\ub9ac\ub294 \ub4dc\ub77c\uc774\ubc84 QUICK \ub4f1\ub85d \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud574\ubcf4\uc138\uc694!',vehicle_license:'\uc6b4\uc804\uba74\ud5c8',please_sign_up_vehicle_license:'\uc6b4\uc804 \uba74\ud5c8\uc815\ubcf4\ub97c \ub4f1\ub85d\ud574\uc8fc\uc138\uc694.',insurance_infor:'\ubcf4\ud5d8\uc815\ubcf4',please_sign_up_insurance_infor:'\uc790\ub3d9\ucc28 \ubcf4\ud5d8 \uc815\ubcf4\ub97c \ub4f1\ub85d\ud574\uc8fc\uc138\uc694.',choose_payment:'\uc815\uc0b0\ubc29\ubc95\uc120\ud0dd',please_choose_payment_when_drive_and_sign_up:'\uce74\ud480\uc815\uc0b0 \ubc29\uc2dd\uc744 \uc120\ud0dd\ud558\uc5ec \ub4f1\ub85d\ud574\uc8fc\uc138\uc694.',register_vacxin_and_business_card:'\ubc31\uc2e0 \ubc0f \uba85\ud568\ub4f1\ub85d',please_sign_up_vacxin_certification_and_card:'\ubc31\uc2e0\uc778\uc99d \ubc0f \uba85\ud568\uc744 \ub4f1\ub85d\ud574\uc8fc\uc138\uc694.',style_you_want:'\uc6d0\ud558\ub294 \uc2a4\ud0c0\uc77c',style_register_guide:'- \ub4dc\ub77c\uc774\ubc84 \uc815\ubcf4 \uc218\uc815\uc744 \uc6d0\ud558\uc2dc\uba74 \uace0\uac1d\uc13c\ud130 \ubb38\uc758 \ub610\ub294 \ubb38\uc758\ud558\uae30 \uac8c\uc2dc\ud310\uc744 \ud1b5\ud574 \ubcc0\uacbd \uc694\uccad\ub0b4\uc6a9\uacfc \uc99d\ube59\uc11c\ub958\ub97c \ucca8\ubd80\ud558\uc5ec \ubcc0\uacbd\uc694\uccad \ubd80\ud0c1\ub4dc\ub9bd\ub2c8\ub2e4.',please_sign_up_style_you_want:'\uce74\ud480\uc2dc \uc6d0\ud558\ub294 \uc2a4\ud0c0\uc77c\uc744 \ub4f1\ub85d\ud574\uc8fc\uc138\uc694.',save:'\uc800\uc7a5\ud558\uae30',number_car:'\ucc28\ub7c9\ubc88\ud638(\ud544\uc218)',card_sample:'\ucc28\ub7c9\ubaa8\ub378(\ud544\uc218)',car_year:'\ucc28\ub7c9\uc5f0\uc2dd(\ud544\uc218)',car_color:'\ucc28\ub7c9\uc0c9\uc0c1(\uc120\ud0dd)',production:'\uc81c\uc870\uc0ac(\uc120\ud0dd)',car_front:'\ucc28\ub7c9\uc55e\uba74',car_back:'\ucc28\ub7c9\ub4b7\uba74',car_side:'\ucc28\ub7c9\uce21\uba74',car_inside:'\ucc28\ub7c9\ub0b4\ubd80',license_type:'\uba74\ud5c8\uc885\ub958',license_number:'\uba74\ud5c8\ubc88\ud638',permanent_registration_number:'\uc8fc\ubbfc\ub4f1\ub85d\ubc88\ud638',expired_date:'\uac31\uc2e0\ub9cc\ub8cc\uc77c',expired_license_date:'\uba74\ud5c8\ub9cc\ub8cc\uc77c',serial_number:'\uc77c\ub82c\ubc88\ud638',attach_license:'\uba74\ud5c8\uc99d \uc0ac\uc9c4 \ucca8\ubd80',image_background_registration:'\ud504\ub85c\ud544\uc0ac\uc9c4\ub4f1\ub85d',expired_insurance_date:'\ubcf4\ud5d8\uc885\ub8cc\uc77c',insurance_registration:'\uc885\ud569\ubcf4\ud5d8 \uac00\uc785 \uc5ec\ubd80',property_compensation_amount:'\ub300\ubb3c\ubc30\uc0c1\uae08\uc561',insurance_driver_history:'\uc6b4\uc804\uc790\ubcf4\ud5d8\uc774\ub825',attach_insurance_card:'\ubcf4\ud5d8\uc99d \uc0ac\uc9c4 \ucca8\ubd80',please_attach_insurance_card:'\ubcf4\ud5d8\uc99d \uc0ac\uc9c4\uc744 \ucca8\ubd80\ud574\uc8fc\uc138\uc694.',business_card_and_vaccine_card:'\uba85\ud568 \ubc0f \ubc31\uc2e0 \ub4f1\ub85d',career:'\uc9c1\uc885',detail_career:'\uc0c1\uc138\uc9c1\uc5c5',name_company:'\ud68c\uc0ac\uba85',address_company:'\ud68c\uc0ac\uc8fc\uc18c',confirm_business_card:'\uba85\ud568 \uc778\uc99d(\ud544\uc218)',optional_vaccine_certification:'\ucf54\ub85c\ub098 \ubc31\uc2e0\uc811\uc885 \uc99d\uba85\uc11c(\uc120\ud0dd)',choose_bank:'\uc740\ud589\uc120\ud0dd',account_number:'\uacc4\uc88c\ubc88\ud638',owner_account:'\uc608\uae08\uc8fc',attach_image_bank_card:'\ud1b5\uc7a5\uc0ac\uc9c4\ucca8\ubd80',please_sign_up_copy_account_number:'\uacc4\uc88c\ubc88\ud638\uac00 \uc0ac\ubcf8\uc744 \ub4f1\ub85d\ud574\uc8fc\uc138\uc694.',car_information_registration:'\ucc28\ub7c9\uc815\ubcf4\ub4f1\ub85d',sign_up_driver_license:'\uc6b4\uc804\uba74\ud5c8 \uc815\ubcf4\ub4f1\ub85d',postCode:'\uc9c0\uc5ed\ubc88\ud638',number:'\uc22b\uc790',area:'\uc9c0\uc5ed',choose:'\uc120\ud0dd',payment_registration:['\ucda9\uc804\uae08\uc785\uae08','\uacc4\uc88c\uc785\uae08'],change_requirement:'\ubcc0\uacbd\uc2e0\uccad',favorite_registration:'\uc6d0\ud558\ub294 \ubd84\uc704\uae30 \ub4f1\ub85d',gender:'\uc131\ubcc4',gender_data:['\uc131\ubcc4\ubb34\uad00','\uc5ec\uc131\ub9cc','\ub0a8\uc131\ub9cc'],go_plane:'\uc88c\uc11d\ud0d1\uc2b9',go_plane_data:['\ud0d1\uc2b9\uc88c\uc11d \ubb34\uad00','\uc55e\uc88c\uc11d \