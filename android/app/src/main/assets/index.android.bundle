__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.months_rule=void 0;e.months_rule="\n\u3141 \ud30c\ud0b9\ubc15\uc571 \uc6d4\uc8fc\ucc28 \uc774\uc6a9\uc548\ub0b4 \ubc0f \ucde8\uc18c, \ud658\ubd88 \uaddc\uc815\n\n1. \uc774\uc6a9\uc548\ub0b4\n  - \uc8fc\ucc28\uc7a5\uc758 \uc6d4\uc8fc\ucc28 \uc2dc\uc791 \uc77c\uc740 \ub9e4\uc6d4 1\uc77c\ubd80\ud130 \ub9d0\uc77c\uae4c\uc9c0 \uc785\ub2c8\ub2e4.\n  - \ub530\ub77c\uc11c, \uc6d4\uc911\uc5d0 \uc911\uac04 \uc785\ucc28\uc744 \ud558\uc2dc\uac8c\ub418\ub294 \uacbd\uc6b0\uc5d0\ub294 \uc2dc\uc791\ud558\ub294 \ud574\ub2f9 \uc6d4\uc740 \uc8fc\ucc28\uc7a5\uc774 \uc815\ud55c \uc6d0\uce59\uc5d0 \uc785\uac01\ud574\uc11c,\n    \uc2dc\uc791\ud558\ub294 \ub2ec \ubc0f \uc775\uc6d4\ub2ec \uacb0\uc81c\ub97c \uac19\uc774(\ub3d9\uc2dc) \uc9c4\ud589\uc744 \ud574\uc8fc\uc154\uc57c \uc774\uc6a9\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.\n    : (\ud558\uc774\ud30c\ud0b9) \uc6b4\uc601\ud558\ub294 \uc8fc\ucc28\uc7a5\uc740 15\uc77c \uc774\uc804/\uc774\ud6c4 \uae30\uc900\uc73c\ub85c \uc6d4\uc8fc\ucc28 \uc694\uae08\uc774 \ucc45\uc815\ub429\ub2c8\ub2e4.\n      \uc2dc\uc791\uc77c\uc774 1\uc77c\ubd80\ud130 ~15\uc77c\uae4c\uc9c0\ub294 \ud55c\ub2ec\uce58 \uc694\uae08\uc801\uc6a9\n      \uc2dc\uc791\uc77c\uc774 16\uc77c \uc774\ud6c4\ubd80\ud130 \uc2dc\uc791\ud558\ub294 \uacbd\uc6b0\uc5d0\ub294 \ub9d0\uc77c\uae4c\uc9c0 \uc6d4\uc8fc\ucc28 \uc694\uae08\uc758 50% \uae08\uc561 \uc801\uc6a9 \ubc0f \uc775\uc6d4\ubd84 \uacb0\uc81c\uae4c\uc9c0 \ub3d9\uc2dc\uc5d0 \uc9c4\ud589\n\u200b\n** \uc774\ub294 \ub9ce\uc740 \ucc28\ub7c9\uc774 \uc774\uc6a9\ud558\ub294 \uc8fc\ucc28\uc7a5 \ud2b9\uc131\uc0c1 \uc6b4\uc601\ud558\ub294 \uc785\uc7a5\uc5d0\uc11c \uc815\ud55c \uc6d0\uce59\uc785\ub2c8\ub2e4. \uc774\uc5d0 \ub300\ud55c \ubd80\ubd84\uc744 \uc6d0\uce58\uc54a\uc73c\uc2dc\uba74 \uacb0\uc81c\ub97c \uc9c4\ud589\ud574\uc8fc\uc2dc\uc9c0 \uc54a\uae30 \ubc14\ub78d\ub2c8\ub2e4.\n\n\n - \uc8fc\ucc28\uc7a5 \uc911, \uc2dc\uc791\uc77c\uc774 \ub9e4\uc6d4 1\uc77c\uc774 \uc544\ub2cc \uc785\ucc28 \uae30\uc900\uc77c\ub85c \uc0bc\ub294 \uc8fc\ucc28\uc7a5\ub4e4\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.\n   : \uc774\ub4e4 \uc8fc\ucc28\uc7a5\uc740 \uacb0\uc81c\uc2dc\uc5d0 \uc800\ud76c \uc6b4\uc601\ud300 \ub2f4\ub2f9\uc790\ub4e4\uc758 \uc548\ub0b4\ub97c \ud1b5\ud574\uc11c, \uacb0\uc81c\ub97c \uc9c4\ud589\ud574 \uc8fc\uc2dc\uba74 \ub429\ub2c8\ub2e4.\n   : \uc774\uc6a9\uae30\uac04 \uae30\uc900\uc77c\uc744 \uc608\uc2dc\ub85c \uc548\ub0b4 - 2020\ub144 1\uc6d4 10\uc77c \uacb0\uc81c \ubc0f \uc2dc\uc791\uc2dc, \uc775\uc6d4\uc5d0\uc11c \ub9c8\uc774\ub108\uc2a4( - ) 1\uc77c\uc744 \ucc28\uac10\ud558\ub294 \ubc29\uc2dd\uc785\ub2c8\ub2e4.\n     \uc6d4\uc8fc\ucc28 \uc801\uc6a9 \uae30\uac04\uc740 2020.01.10 ~ 02.09 \uc774\uba70, \ub9e4\ub2ec \uac31\uc2e0\uc2dc\uc5d0\ub294 \uc885\ub8cc\ub418\uae30 1\uc77c \uc804\uc5d0 \uacb0\uc81c\ub97c \uc644\ub8cc\ud574\uc8fc\uc154\uc57c \uc5f0\uc7a5\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.\n   : \ub610\ud55c, \uc6d4\uc8fc\ucc28 \uc885\ub8cc \uc77c\uc5d0 \ub0a0\uc9dc\ub97c \uc774\uc5b4\uc11c\ub9cc '\uc5f0\uc7a5(\uac31\uc2e0)'\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.\n     \uc608\ub97c \ub4e4\uc5b4\uc11c, 2\uc6d4 9\uc77c \uc885\ub8cc\uac00 \ub418\ub2e4\uba74, 2\uc6d4 10\uc77c\ubd80\ud130 \uc5f0\uc7a5\uc744 \ud574\uc8fc\uc154\uc57c \ud569\ub2c8\ub2e4.\n     \uc8fc\ub9d0\uc774\ub098 \uacf5\ud734\uc77c/\ud734\uac00 \ub4f1\uc774 \uae30\uac04\uc774 \uc788\uc5b4\ub3c4 \uc885\ub8cc\ub418\ub294 \ub0a0\uc9dc\uc5d0 \uc774\uc5b4\uc11c\ub9cc \uacb0\uc81c\ub97c \ud574\uc8fc\uc154\uc57c \uc774\uc6a9\uc774 \uac00\ub2a5\ud569\ub2c8\ub2e4.\n     \uc774\uc810, \uac1c\ubcc4 \uc8fc\ucc28\uc7a5\uc774 \uc815\ud55c \uc6d0\uce59\uc774\uae30\ub54c\ubb38\uc5d0 \uc591\ud574\ub97c \ubd80\ud0c1\ub4dc\ub9ac\uaca0\uc2b5\ub2c8\ub2e4.\n\u200b\n\u200b\n2. \uc6d4\uc8fc\ucc28\uad8c \uad6c\ub9e4(\uc774\uc6a9\uc911)\ud6c4 \uc911\uac04\uc5d0 \ud574\uc9c0\ucc98\ub9ac\ub97c \uc694\uccad\ud558\uc2dc\ub294 \uacbd\uc6b0\uc5d0\ub294\n\uacb0\uc81c\ud558\uc2e0 \ud574\ub2f9 \uc8fc\ucc28\uc7a5\uc774 \uc815\ud55c \uc6d0\uce59\uc5d0 \ub530\ub77c\uc11c \ud574\uc9c0\ucc98\ub9ac\ub97c \uc9c4\ud589\ud574\ub4dc\ub9bd\ub2c8\ub2e4.\n\u200b\n\ud574\uc9c0\uc694\uccad \uae30\uc900\uc77c\uc740 \uacfc\uac70\ub85c \uc18c\uae09\uc801\uc6a9\ub418\uc9c0 \uc54a\uc73c\uba70, \ud574\uc9c0 \ucc98\ub9ac\ub97c \uc694\uccad\ud55c \ub0a0\ub85c \uc801\uc6a9\ub429\ub2c8\ub2e4.\n\ub2e4\ub9cc, \ucc28\uac00 \uc8fc\ucc28\uc7a5\uc5d0 \uc8fc\ucc28\ub418\uc5b4\uc838 \uc788\ub294 \uacbd\uc6b0\uc5d0\ub294 \ucc28\uac00 \ucd9c\ucc28\ub418\ub294 \ub0a0\uc744 \uae30\uc900\uc73c\ub85c \uacb0\uc815\ud569\ub2c8\ub2e4.\n\u200b\n\ub610\ud55c, \ud574\uc9c0\ucc98\ub9ac \uc694\uccad\uc2dc \uc774\uc6a9\uc77c\uc218 \uacf1\ud558\uae30 \uac1c\ubcc4\uc8fc\ucc28\uc7a5\uc774 \uc815\ud55c 1\uc77c \ucd5c\ub300\uc694\uae08(1\uc77c 2\ub9cc\uc6d0~5\ub9cc\uc6d0)\uc73c\ub85c \uc801\uc6a9 \ubc0f \uacc4\uc0b0\ub429\ub2c8\ub2e4.\n\u200b\n** \uc608\uc2dc) 5\uc77c(\uacbd\uacfc) \xd7 \uac1c\ubcc4\uc8fc\ucc28\uc7a5 1\uc77c \ucd5c\ub300\uc694\uae08 2\ub9cc\uc6d0 = > 10\ub9cc\uc6d0\uc758 \uc694\uae08\uc774 \uccad\uad6c\ub429\ub2c8\ub2e4.\n** \uc774\ub294 \uc6d4\uc8fc\ucc28\uad8c \uae08\uc561\uc774 1\uc77c\uad8c \uae08\uc561\uc744 30\uc77c(31\uc77c) \uacf1\ud574\uc9c4 \uae08\uc561\uc5d0\uc11c \ud560\uc778 \uc801\uc6a9\uc774 \ub41c \uae08\uc561\uc774\uae30 \ub54c\ubb38\uc774\uba70,\n\uc6d4\uc8fc\ucc28 \ucc28\ub7c9\uc740 \uc8fc\ucc28\uc7a5\uc744 \uc218\uc2dc\ub85c \uc785.\ucd9c\ucc28\uac00 \uac00\ub2a5\ud55c \uc8fc\ucc28\uad8c\uc774\uae30 \ub54c\ubb38\uc5d0 '1\uc77c \ucd5c\ub300\uc694\uae08'\uc774 \uc801\uc6a9\uc774 \ub429\ub2c8\ub2e4.\n(\ud3c9\uc77c \ubc0f \uc8fc\ub9d0 1\uc77c\uad8c, \uc2ec\uc57c\uad8c, \uc2dc\uac04\uad8c \ub4f1\uc740 \uc785\ucc28 \ud6c4\uc5d0 \ucd9c\ucc28\ub97c \ud558\uc2dc\uba74, \uadf8 \uac74\uc73c\ub85c \uc885\ub8cc\ucc98\ub9ac\uac00 \ub429\ub2c8\ub2e4.\n \ud558\uc9c0\ub9cc, \uc6d4\uc8fc\ucc28\uad8c \uc774\uc6a9 \uace0\uac1d\uc740 1\uc77c\uc911\uc5d0 \uc218\uc2dc\ub85c \uc8fc\ucc28\uc7a5\uc744 \uc785/\ucd9c\ucc28 \ubc18\ubcf5\uc744 \ud574\ub3c4 \uc8fc\ucc28\uc694\uae08 \uc9d5\uc218\uac00 \ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.)\n\n\u3141 \uc704\uc758 \ubaa8\ub4e0 \ub0b4\uc6a9\uc740 \uae30\uc874\uc758 \uc6d4\uc8fc\ucc28 \uc774\uc6a9 \uc911\uc774\uc2e0 \ubaa8\ub4e0 \uace0\uac1d\uc5d0\uac8c \uc18c\uae09 \uc801\uc6a9\ub429\ub2c8\ub2e4.\n\n2019\ub144 12\uc6d4 17\uc77c\n"},3058,[]);
